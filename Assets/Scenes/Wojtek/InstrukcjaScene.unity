      m_Calls: []
  m_text: "Po puszczeniu kasety losuje si\u0119 jedna z minigier.\n\n Gdy wylosuje
    si\u0119 gra w \u015Bwiat\u0142a nale\u017Cy ustawi\u0107 prze\u0142\u0105czniki
    w ka\u017Cdym rogu w taki spos\xF3b, by ca\u0142a plansza by\u0142a zapalona.\n\nGdy
    wylosuje si\u0119 gra w dopasowanie fali nale\u017Cy tak manipulowa\u0107 trzema
    suwakami przy konsoli, by ich warto\u015B\u0107 by\u0142a bliska wy\u015Bwietlonej
    oczekiwanej warto\u015Bci.\n\nPo ich uko\u0144czeniu gracz uzyskuje r\xF3\u017Cne
    bonusy.\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
