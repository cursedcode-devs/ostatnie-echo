  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "W tej grze prowadzisz audycj\u0119 radiow\u0105. Wybierasz jak\u0105 muzyk\u0119
    lub jak\u0105 reklam\u0119 b\u0119dziesz gra\u0142 w danej godzinie. Gdy grasz
    muzyk\u0119 zyskujesz widz\xF3w. Gdy grasz reklam\u0119, zyskujesz pieni\u0105dze.
    By wygra\u0107 musisz zyska\u0107 okre\u015Blon\u0105 liczb\u0119 widz\xF3w przed
    up\u0142ywem czasu i nigdy nie straci\u0107 wszystkich swoich pieni\u0119dzy.\n\nPomi\u0119dzy
    puszczanymi kasetami (czyli reklamami i muzyk\u0105) pojawia\u0107 si\u0119 b\u0119d\u0105
    minigry, kt\xF3re gdy je pozytywnie uko\u0144czysz mog\u0105 dawa\u0107 r\xF3\u017Cne
    bonusy."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: aa077d21d15bbe14895bf3914cb69409, type: 2}
  m_sharedMaterial: {fileID: 2100000, guid: 4118bcba525a1e6498ebcae80f4beddf, type: 2}
