    listenersPrecentageChange: 0
    requestedGenre: 
    flatListenersChange:
      hipHop: 0
      disco: 0
      rock: 0
      pop: 0
    hostDelta: 1
    listenerDelta: 1
    governmentDelta: 0
  - optionText: "S\u0142uchaj m\u0142ody, czas antenowy to u nas towar deficytowy,
      na mi\u0142osne sprawy nie ma tu miejsca."
