  callType: 1
  callerName: "Wr\xF3\u017Cka Samanta"
  audio: {fileID: 0}
  initialDialog: "Dzie\u0144 dobry, m\xF3wi Wr\xF3\u017Cka Samanta. Gwiazdy m\xF3wi\u0105,
    \u017Ce twoja antena potrzebuje mojej astralnej energii. Musisz pu\u015Bci\u0107
    m\xF3j horoskop w nast\u0119pnym bloku. Je\u015Bli odm\xF3wisz, si\u0142y supernaturalne
    zniszcz\u0105 tw\xF3j nadajnik, a kosmiczny pech dopadnie studio."
  dialogOptions:
  - optionText: "No dobra, nie b\u0119d\u0119 zadziera\u0107 z kosmosem. Wrzucam
      pani horoskop na anten\u0119."
    resultingText: 
    moneyChange: 0
    listenersPrecentageChange: 0
    requestedGenre: 
    flatListenersChange:
      hipHop: 0
      disco: 0
      rock: 0
      pop: 0
    hostDelta: 1
    listenerDelta: 0
    governmentDelta: 0
  - optionText: "Pani Samanto, radio dzia\u0142a na pr\u0105d i tranzystory, a nie
      na uk\u0142ad gwiazd. Prosz\u0119 nie blokowa\u0107 linii."
