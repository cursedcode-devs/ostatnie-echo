  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Gra jest podzielona na godziny i dni. Jeden dzie\u0144 ma 7 godzin. Ca\u0142a
    gra trwa 7 dni.\n\nPodczas jednej godziny mo\u017Cna wybra\u0107 kaset\u0119
    do grania (u g\xF3ry muzyka, na dole reklamy) poprzez naci\u015Bni\u0119cie jej
    lewym przyciskiem myszy. Gdy kaseta unosi si\u0119 w powietrzu znaczy, \u017Ce
    jest wybrana. Gdy jest wybrana kaseta i naci\u015Bniemy konsole kaseta si\u0119
    odtworzy.\n\nZa ka\u017Cdym zagraniem kasety jednego dnia jej efektywno\u015B\u0107
    tego dnia zmniejsza si\u0119. W nowym dniu efektywno\u015B\u0107 wszystkich kaset
    resetuje si\u0119."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
