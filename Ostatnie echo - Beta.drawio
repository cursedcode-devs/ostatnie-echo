        <mxCell id="Z2LjrlFw7QWzF2_aZ2f6-54" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Puszczanie kaset - format combo&lt;/h1&gt;&lt;p&gt;Podczas pojedynczego czasu antenowego gracz ma 3 sloty na odtworzenie muzyki. Celem jest wybranie spośród dostępnych kaset takiego zestawu który odtworzony naraz wyciągnie jak największy przyrost.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="641" x="879" y="660" as="geometry" />
        </mxCell>
        <mxCell id="Z2LjrlFw7QWzF2_aZ2f6-55" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" value="&lt;b&gt;Problemy&lt;/b&gt;&amp;nbsp;- odpowiedzi" vertex="1">
