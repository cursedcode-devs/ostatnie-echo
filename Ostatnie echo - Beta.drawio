        <mxCell id="Z2LjrlFw7QWzF2_aZ2f6-2" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Flow rozgrywki&lt;/h1&gt;&lt;p&gt;Przykładowy schemat przedstawiający przepływ jednego dnia. Gracz musi wykorzystywać swój czas antenowy świadomie poprzez balans między rozwojem stacji, zarabianiem a pomocom ludziom w potrzebie.&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="680" y="90" as="geometry" />
        </mxCell>
