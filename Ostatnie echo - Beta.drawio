        </mxCell>
        <mxCell id="Z2LjrlFw7QWzF2_aZ2f6-56" parent="Z2LjrlFw7QWzF2_aZ2f6-55" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;b&gt;Monotonia &lt;/b&gt;- przerywana przez różne interakcje z ludźmi poprzez rozmowy telefoniczne oraz przez różnorodne reklamy" vertex="1">
          <mxGeometry height="30" width="571" y="30" as="geometry" />
        </mxCell>
        <mxCell id="Z2LjrlFw7QWzF2_aZ2f6-57" parent="Z2LjrlFw7QWzF2_aZ2f6-55" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;b&gt;Brak wyzwania &lt;/b&gt;- rozdysponowanie ograniczonego stale czasu antenowego" vertex="1">
          <mxGeometry height="30" width="571" y="60" as="geometry" />
        </mxCell>
        <mxCell id="Z2LjrlFw7QWzF2_aZ2f6-58" parent="Z2LjrlFw7QWzF2_aZ2f6-55" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" value="&lt;b&gt;Dlaczego wygrać &lt;/b&gt;-&amp;nbsp; dowiedzieć się więcej o ludziach i im pomóc, satysfakcja z pozytywnych reakcji lub konsekwencje z bycia gówniarzem, nabić jak największy wynik" vertex="1">
          <mxGeometry height="40" width="571" y="90" as="geometry" />
        </mxCell>
        <mxCell id="Z2LjrlFw7QWzF2_aZ2f6-74" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" value="Aktywności" vertex="1">
